# 拷贝一份重命名为 .env，并填入你真实的 Key
# 注意：.env 文件已被 .gitignore 忽略，绝不能上传到 GitHub！
DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
GEMINI_API_KEY="AIzaSy... / AQ...."

# 监听地址，默认仅本机。如需对局域网开放可改为 0.0.0.0（不推荐）。
HOST=127.0.0.1
PORT=8000

# 允许的浏览器来源，多个以逗号分隔。未写端口时会匹配该主机的任意端口。
# 默认等同于：http://127.0.0.1,http://localhost,http://[::1]
# CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
